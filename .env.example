# ==============================================================================
# Environment Configuration Template (Copy to .env for local overrides)
# ==============================================================================

# Flask Core Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cryptographic Master Secrets (Must be at least 32 bytes in production)
SECRET_KEY=dev-attendance-secret-key-change-in-production-2026

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendence_db

# Redis Distributed Cache Connection URL
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Lockout Parameters
LOCKOUT_THRESHOLD=3
LOCKOUT_DURATION_SECONDS=900

# Biometric & Anti-Spoofing Thresholds
FACE_MATCH_THRESHOLD=0.70
MTCNN_CONFIDENCE_THRESHOLD=0.92
EAR_BLINK_THRESHOLD=0.22
