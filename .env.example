# ==============================================================================
# Environment Configuration Template (Copy to .env for local overrides)
# ==============================================================================

# Flask Core Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Signs session cookies, JWTs and QR tokens. Required: the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendence_db

# Redis Distributed Cache Connection URL (optional: remove to use the in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# Admin self-registration. false (default): only the first admin can sign up without
# logging in; later admins must be created by an existing admin. true: anyone can
# create an admin account (use only for public demo deployments).
ALLOW_PUBLIC_ADMIN_SIGNUP=false

# Rate Limiting & Lockout Parameters
LOCKOUT_THRESHOLD=3
LOCKOUT_DURATION_SECONDS=900

# Biometric Thresholds (eye-blink liveness runs in the kiosk browser and has no server setting)
FACE_MATCH_THRESHOLD=0.70
MTCNN_CONFIDENCE_THRESHOLD=0.90
